{
  "entities": {
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "A summarized personal reflective journaling record with sentiment, themes, and action items.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique journal entry document ID" },
        "userId": { "type": "string", "description": "Owner Firebase UID" },
        "title": { "type": "string", "maxLength": 200, "description": "Title of journal entry" },
        "summary": { "type": "string", "maxLength": 10000, "description": "Deep narrative reflection summary" },
        "mood": { "type": "string", "maxLength": 50, "description": "Predominant emotional state" },
        "sentimentScore": { "type": "number", "description": "Valence score from -1.0 to 1.0" },
        "keyThemes": { "type": "array", "description": "Extracted recurring themes" },
        "actionItems": { "type": "array", "description": "Actionable commitments" },
        "conversationSnippet": { "type": "string", "maxLength": 500, "description": "Excerpt of original chat" },
        "messageCount": { "type": "number", "description": "Total turns in session" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last modified timestamp" }
      },
      "required": ["userId", "title", "summary", "mood", "sentimentScore", "keyThemes", "actionItems", "createdAt", "updatedAt"]
    },
    "ConversationSession": {
      "title": "ConversationSession",
      "description": "Multi-turn interactive reflection transcript with the companion.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Session document ID" },
        "userId": { "type": "string", "description": "Owner Firebase UID" },
        "title": { "type": "string", "maxLength": 200, "description": "Session topic headline" },
        "messages": { "type": "array", "description": "List of turns exchanged" },
        "status": { "type": "string", "enum": ["active", "saved", "archived"], "description": "Session lifecycle state" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last updated timestamp" }
      },
      "required": ["userId", "messages", "status", "createdAt", "updatedAt"]
    },
    "PersonalInsight": {
      "title": "PersonalInsight",
      "description": "Longitudinal psychological and philosophical synthesis of entries over time.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Insight document ID" },
        "userId": { "type": "string", "description": "Owner Firebase UID" },
        "period": { "type": "string", "maxLength": 100, "description": "Time window analyzed" },
        "synthesis": { "type": "string", "maxLength": 10000, "description": "Detailed pattern analysis" },
        "recurringThemes": { "type": "array", "description": "Prominent persistent themes" },
        "emotionalTrend": { "type": "string", "maxLength": 300, "description": "Observed emotional trajectory" },
        "recommendations": { "type": "array", "description": "Tailored reflective inquiry questions" },
        "entryCountAnalyzed": { "type": "number", "description": "Number of entries evaluated" },
        "generatedAt": { "type": "string", "format": "date-time", "description": "Timestamp of generation" }
      },
      "required": ["userId", "period", "synthesis", "recurringThemes", "emotionalTrend", "recommendations", "generatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/journals/{journalId}": {
      "schema": "JournalEntry",
      "description": "Stores user-owned reflective journal records."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "ConversationSession",
      "description": "Stores active and historical multi-turn journal conversations."
    },
    "/users/{userId}/insights/{insightId}": {
      "schema": "PersonalInsight",
      "description": "Stores longitudinal insights generated by Gemini."
    }
  }
}
